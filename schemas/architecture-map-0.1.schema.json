{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringspec.org/schemas/architecture-map-0.1.schema.json",
  "title": "EngineeringSpec read-only architecture map",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "authority", "components"],
  "properties": {
    "format": { "const": "engineering-architecture-map" },
    "version": { "const": "0.1" },
    "authority": { "const": "read_only" },
    "components": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dependencies", "standards", "paths", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "system": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "standards": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "document"],
            "properties": { "file": { "type": "string" }, "document": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    }
  }
}
