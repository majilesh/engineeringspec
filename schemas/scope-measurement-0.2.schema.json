{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringspec.org/schemas/scope-measurement-0.2.schema.json",
  "title": "EngineeringSpec unsigned repository-routing scope receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "authorization", "contract", "baseSha", "headSha", "candidateSetDigest", "routingDecisionDigest", "method", "authorityBreadth", "metricEligibility", "counts", "digests", "limitations"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "authority": { "const": "base_pinned_repository_routing" },
    "authorization": { "const": "none" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "path", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "baseSha": { "$ref": "#/$defs/sha" },
    "headSha": { "$ref": "#/$defs/sha" },
    "candidateSetDigest": { "$ref": "#/$defs/digest" },
    "routingDecisionDigest": { "$ref": "#/$defs/digest" },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "version"],
      "properties": {
        "unit": { "const": "repository_path" },
        "version": { "const": "concrete-paths-v2" }
      }
    },
    "authorityBreadth": { "enum": ["finite", "open_create_namespace", "repository_wide"] },
    "metricEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopePrecision", "reason"],
      "properties": {
        "scopePrecision": { "type": "boolean" },
        "reason": { "enum": ["eligible", "open_create_namespace", "repository_wide", "zero_denominator", "negative_routing_outcome"] }
      }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "digests": { "$ref": "#/$defs/digests" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedWritable", "actualChanged", "selectedForRequestedContract", "selectedForOtherContracts", "denied", "ambiguous", "uncovered"],
      "properties": {
        "approvedWritable": { "$ref": "#/$defs/paths" },
        "actualChanged": { "$ref": "#/$defs/paths" },
        "selectedForRequestedContract": { "$ref": "#/$defs/paths" },
        "selectedForOtherContracts": { "$ref": "#/$defs/paths" },
        "denied": { "$ref": "#/$defs/paths" },
        "ambiguous": { "$ref": "#/$defs/paths" },
        "uncovered": { "$ref": "#/$defs/paths" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedWritablePaths", "actualChangedPaths", "selectedForRequestedContract", "selectedForOtherContracts", "denied", "ambiguous", "uncovered"],
      "properties": {
        "approvedWritablePaths": { "$ref": "#/$defs/count" },
        "actualChangedPaths": { "$ref": "#/$defs/count" },
        "selectedForRequestedContract": { "$ref": "#/$defs/count" },
        "selectedForOtherContracts": { "$ref": "#/$defs/count" },
        "denied": { "$ref": "#/$defs/count" },
        "ambiguous": { "$ref": "#/$defs/count" },
        "uncovered": { "$ref": "#/$defs/count" }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedWritablePaths", "actualChangedPaths", "selectedForRequestedContract", "selectedForOtherContracts", "denied", "ambiguous", "uncovered"],
      "properties": {
        "approvedWritablePaths": { "$ref": "#/$defs/digest" },
        "actualChangedPaths": { "$ref": "#/$defs/digest" },
        "selectedForRequestedContract": { "$ref": "#/$defs/digest" },
        "selectedForOtherContracts": { "$ref": "#/$defs/digest" },
        "denied": { "$ref": "#/$defs/digest" },
        "ambiguous": { "$ref": "#/$defs/digest" },
        "uncovered": { "$ref": "#/$defs/digest" }
      }
    },
    "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
