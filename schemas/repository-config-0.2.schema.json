{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringspec.org/schemas/repository-config-0.2.schema.json",
  "title": "EngineeringSpec repository configuration 0.2",
  "description": "Adds adoption modes and repository policy (RFC 0014). A configuration without mode keeps legacy routing.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "specDirectory": { "type": "string", "minLength": 1 },
    "strict": { "type": "boolean" },
    "trustedBase": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["advisory", "standard", "controlled"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governedPaths": { "$ref": "#/$defs/globs" },
        "exemptPaths": { "$ref": "#/$defs/globs" },
        "protectedPaths": { "$ref": "#/$defs/globs" },
        "grantBeforeSpendPaths": { "$ref": "#/$defs/globs" }
      }
    },
    "trustedVerifiers": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*#[A-Z][A-Z0-9_-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv"],
        "properties": {
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "workingDirectory": { "type": "string", "minLength": 1 },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "network": { "enum": ["deny", "allow"] }
        }
      }
    }
  },
  "$defs": {
    "globs": {
      "description": "Restricted EngineeringSpec glob dialect: literal segments plus *, **, and ?.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
