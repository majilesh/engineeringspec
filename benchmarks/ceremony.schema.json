{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringspec.org/schemas/ceremony-0.2.schema.json",
  "description": "Ceremony scenarios declare expectations only. Results are measured by executing the real CLI; authored measured fields such as actualOutcome are rejected.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "engineering-spec-ceremony-scenarios"
    },
    "formatVersion": {
      "const": "0.2"
    },
    "scenarios": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "name",
        "concepts",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        "name": {
          "type": "string"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "type": "object",
          "required": [
            "outcome",
            "diagnostics",
            "currentAuthorityGranted",
            "pullRequests"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "selected",
                "fail_closed",
                "historical_read_only",
                "trusted_result_unchanged"
              ]
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "currentAuthorityGranted": {
              "type": "boolean"
            },
            "pullRequests": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
