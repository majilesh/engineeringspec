{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineeringspec.org/schemas/agent-impact.schema.json",
  "title": "EngineeringSpec paired agent-impact benchmark record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "runId",
    "condition",
    "agent",
    "success",
    "scopeViolations",
    "reviewCorrections",
    "durationSeconds",
    "inputTokens",
    "outputTokens"
  ],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "taskRiskTier": { "enum": ["low", "medium", "high"] },
    "runId": { "type": "string", "minLength": 1 },
    "pairId": { "type": "string", "minLength": 1 },
    "condition": { "enum": ["baseline", "engineeringspec"] },
    "conditionIdentity": { "type": "string", "minLength": 1 },
    "evidenceClass": { "enum": ["observed", "example"] },
    "repositoryRevision": { "type": "string", "minLength": 1 },
    "headRevision": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "agentVersion": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "promptIntent": { "type": "string", "minLength": 1 },
    "taskPromptDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "trustedChecks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "agentConfiguration": { "type": "string", "minLength": 1 },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "engineeringSpecVersion": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "reviewBlinded": { "type": "boolean" },
    "timeLimitSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "acceptanceReviewerId": { "type": "string", "minLength": 1 },
    "conditionSequence": { "enum": [1, 2] },
    "success": { "type": "boolean" },
    "scopeViolations": { "type": "number", "minimum": 0 },
    "reviewCorrections": { "type": "number", "minimum": 0 },
    "durationSeconds": { "type": "number", "minimum": 0 },
    "inputTokens": { "type": "number", "minimum": 0 },
    "outputTokens": { "type": "number", "minimum": 0 },
    "contractAuthoringSeconds": { "type": ["number", "null"], "minimum": 0 },
    "contractReviewSeconds": { "type": ["number", "null"], "minimum": 0 },
    "contractAmendments": { "type": ["integer", "null"], "minimum": 0 },
    "firstPassGateSuccess": { "oneOf": [{ "type": "boolean" }, { "const": "not_applicable" }, { "type": "null" }] },
    "reviewCycles": { "type": ["integer", "null"], "minimum": 0 },
    "exploredPaths": { "type": ["integer", "null"], "minimum": 0 },
    "unauthorizedPathsChanged": { "type": ["integer", "null"], "minimum": 0 },
    "unauthorizedPathsMerged": { "type": ["integer", "null"], "minimum": 0 },
    "scope": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "methodVersion", "approvedWritablePaths", "actualChangedPaths", "catchAllTarget"],
          "properties": {
            "unit": { "const": "repository_path" },
            "methodVersion": { "const": "concrete-paths-v1" },
            "approvedWritablePaths": { "type": "integer", "minimum": 0 },
            "actualChangedPaths": { "type": "integer", "minimum": 0 },
            "catchAllTarget": { "type": "boolean" },
            "authorityBreadth": { "enum": ["finite", "open_create_namespace", "repository_wide"] }
          }
        }
      ]
    },
    "scopeReceipt": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["schemaVersion", "method", "authorityBreadth", "counts"],
          "properties": {
            "schemaVersion": { "const": "0.1" },
            "method": {
              "type": "object",
              "required": ["unit", "version"],
              "properties": {
                "unit": { "const": "repository_path" },
                "version": { "const": "concrete-paths-v1" }
              }
            },
            "authorityBreadth": { "enum": ["finite", "open_create_namespace", "repository_wide"] },
            "counts": {
              "type": "object",
              "required": ["approvedWritablePaths", "actualChangedPaths", "authorizedChangedPaths", "unauthorizedPathsChanged"],
              "properties": {
                "approvedWritablePaths": { "type": "integer", "minimum": 0 },
                "actualChangedPaths": { "type": "integer", "minimum": 0 },
                "authorizedChangedPaths": { "type": "integer", "minimum": 0 },
                "unauthorizedPathsChanged": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "authority", "authorization", "contract", "baseSha", "headSha", "candidateSetDigest", "routingDecisionDigest", "method", "authorityBreadth", "metricEligibility", "counts", "digests", "limitations"],
          "properties": {
            "schemaVersion": { "const": "0.2" },
            "authority": { "const": "base_pinned_repository_routing" },
            "authorization": { "const": "none" },
            "contract": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision", "path", "digest"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "revision": { "type": "integer", "minimum": 1 },
                "path": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            },
            "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "candidateSetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "routingDecisionDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "method": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unit", "version"],
              "properties": { "unit": { "const": "repository_path" }, "version": { "const": "concrete-paths-v2" } }
            },
            "authorityBreadth": { "enum": ["finite", "open_create_namespace", "repository_wide"] },
            "metricEligibility": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scopePrecision", "reason"],
              "properties": {
                "scopePrecision": { "type": "boolean" },
                "reason": { "enum": ["eligible", "open_create_namespace", "repository_wide", "zero_denominator", "negative_routing_outcome"] }
              }
            },
            "counts": { "$ref": "#/$defs/v2Counts" },
            "digests": { "$ref": "#/$defs/v2Digests" },
            "paths": { "type": "object" },
            "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "v2Counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedWritablePaths", "actualChangedPaths", "selectedForRequestedContract", "selectedForOtherContracts", "denied", "ambiguous", "uncovered"],
      "properties": {
        "approvedWritablePaths": { "type": "integer", "minimum": 0 },
        "actualChangedPaths": { "type": "integer", "minimum": 0 },
        "selectedForRequestedContract": { "type": "integer", "minimum": 0 },
        "selectedForOtherContracts": { "type": "integer", "minimum": 0 },
        "denied": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "uncovered": { "type": "integer", "minimum": 0 }
      }
    },
    "v2Digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedWritablePaths", "actualChangedPaths", "selectedForRequestedContract", "selectedForOtherContracts", "denied", "ambiguous", "uncovered"],
      "properties": {
        "approvedWritablePaths": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "actualChangedPaths": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "selectedForRequestedContract": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "selectedForOtherContracts": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "denied": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "ambiguous": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "uncovered": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
